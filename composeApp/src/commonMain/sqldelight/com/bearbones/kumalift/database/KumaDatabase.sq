CREATE TABLE workouts (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    splitType TEXT NOT NULL,
    startTimeEpochMs INTEGER NOT NULL,
    endTimeEpochMs INTEGER,
    durationSeconds INTEGER NOT NULL,
    sessionRpe REAL,
    notes TEXT,
    isFinished INTEGER NOT NULL DEFAULT 0,
    avgHeartRateBpm INTEGER,
    peakHeartRateBpm INTEGER,
    activeCaloriesKcal REAL
);

CREATE TABLE workout_exercises (
    id TEXT NOT NULL PRIMARY KEY,
    workoutId TEXT NOT NULL,
    exerciseId TEXT NOT NULL,
    exerciseName TEXT NOT NULL,
    primaryMuscle TEXT NOT NULL,
    equipment TEXT NOT NULL,
    movementType TEXT NOT NULL,
    orderIndex INTEGER NOT NULL,
    pinnedNote TEXT,
    FOREIGN KEY (workoutId) REFERENCES workouts(id) ON DELETE CASCADE
);

CREATE TABLE sets (
    id TEXT NOT NULL PRIMARY KEY,
    workoutExerciseId TEXT NOT NULL,
    workoutId TEXT NOT NULL,
    setNumber INTEGER NOT NULL,
    setType TEXT NOT NULL,
    weightKg REAL NOT NULL,
    reps INTEGER NOT NULL,
    isCompleted INTEGER NOT NULL DEFAULT 0,
    rpe REAL,
    rir INTEGER,
    targetWeightKg REAL,
    targetReps INTEGER,
    previousWeightKg REAL,
    previousReps INTEGER,
    heartRateBpm INTEGER,
    completedAtEpochMs INTEGER,
    FOREIGN KEY (workoutExerciseId) REFERENCES workout_exercises(id) ON DELETE CASCADE
);

CREATE TABLE personal_records (
    id TEXT NOT NULL PRIMARY KEY,
    exerciseId TEXT NOT NULL,
    exerciseName TEXT NOT NULL,
    weightKg REAL NOT NULL,
    reps INTEGER NOT NULL,
    estimated1RmKg REAL NOT NULL,
    dateAchievedEpochMs INTEGER NOT NULL,
    deltaWeightKg REAL NOT NULL,
    prTier TEXT NOT NULL,
    sourceSetId TEXT
);

CREATE TABLE bodyweight_log (
    id TEXT NOT NULL PRIMARY KEY,
    dateEpochMs INTEGER NOT NULL,
    weightKg REAL NOT NULL,
    note TEXT
);

CREATE TABLE custom_exercises (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    primaryMuscle TEXT NOT NULL,
    secondaryMuscles TEXT NOT NULL DEFAULT '',
    equipment TEXT NOT NULL,
    movementType TEXT NOT NULL,
    defaultIncrementKg REAL NOT NULL DEFAULT 2.5,
    pinnedNote TEXT,
    createdAtEpochMs INTEGER NOT NULL
);

CREATE TABLE training_programs (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    description TEXT NOT NULL,
    category TEXT NOT NULL,
    targetDaysPerWeek INTEGER NOT NULL DEFAULT 3,
    activeDays TEXT NOT NULL DEFAULT '1,3,5',
    isDefault INTEGER NOT NULL DEFAULT 0,
    createdAtEpochMs INTEGER NOT NULL,
    presetKey TEXT DEFAULT NULL,
    isUserRenamed INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE routines (
    id TEXT NOT NULL PRIMARY KEY,
    programId TEXT NOT NULL DEFAULT 'program_hypertrophy_default',
    title TEXT NOT NULL,
    splitCategory TEXT NOT NULL,
    muscleFocus TEXT NOT NULL,
    estimatedDurationMinutes INTEGER NOT NULL,
    targetRpeTier TEXT NOT NULL,
    plannedSetsPerExercise INTEGER NOT NULL,
    isCustom INTEGER NOT NULL DEFAULT 1,
    createdAtEpochMs INTEGER NOT NULL,
    scheduledDays TEXT NOT NULL DEFAULT '',
    presetKey TEXT DEFAULT NULL,
    isUserRenamed INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE routine_exercises (
    id TEXT NOT NULL PRIMARY KEY,
    routineId TEXT NOT NULL,
    exerciseId TEXT NOT NULL,
    orderIndex INTEGER NOT NULL,
    targetSets INTEGER NOT NULL DEFAULT 3,
    targetReps INTEGER NOT NULL DEFAULT 8,
    targetWeightKg REAL,
    restTimerSeconds INTEGER NOT NULL DEFAULT 90,
    setConfigsJson TEXT NOT NULL DEFAULT '',
    FOREIGN KEY (routineId) REFERENCES routines(id) ON DELETE CASCADE
);

CREATE TABLE active_workout_state (
    id TEXT NOT NULL PRIMARY KEY,
    workoutJson TEXT NOT NULL,
    lastUpdatedEpochMs INTEGER NOT NULL
);

CREATE TABLE user_settings_storage (
    id TEXT NOT NULL PRIMARY KEY,
    settingsJson TEXT NOT NULL,
    version INTEGER NOT NULL DEFAULT 1,
    lastUpdatedEpochMs INTEGER NOT NULL
);

CREATE TABLE safety_snapshots (
    id TEXT NOT NULL PRIMARY KEY,
    createdAtEpochMs INTEGER NOT NULL,
    payloadJson TEXT NOT NULL
);

CREATE TABLE workout_schedule_events (
    id TEXT NOT NULL PRIMARY KEY,
    routineId TEXT,
    scheduledDate TEXT NOT NULL,
    status TEXT NOT NULL DEFAULT 'PLANNED',
    linkedWorkoutId TEXT,
    routineTitleSnapshot TEXT NOT NULL,
    splitTypeSnapshot TEXT,
    notes TEXT,
    createdAtEpochMs INTEGER NOT NULL,
    updatedAtEpochMs INTEGER NOT NULL,
    FOREIGN KEY (routineId) REFERENCES routines(id) ON DELETE SET NULL,
    FOREIGN KEY (linkedWorkoutId) REFERENCES workouts(id) ON DELETE SET NULL
);

CREATE TABLE mesocycles (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    programId TEXT,
    totalWeeks INTEGER NOT NULL,
    currentWeek INTEGER NOT NULL,
    deloadWeek INTEGER NOT NULL,
    isDeloadActive INTEGER NOT NULL,
    startDateEpochMs INTEGER NOT NULL,
    endDateEpochMs INTEGER,
    status TEXT NOT NULL,
    notes TEXT NOT NULL DEFAULT '',
    createdAtEpochMs INTEGER NOT NULL
);

CREATE TABLE daily_readiness (
    id TEXT NOT NULL PRIMARY KEY,
    dateString TEXT NOT NULL,
    sleepScore INTEGER NOT NULL,
    sorenessScore INTEGER NOT NULL,
    energyScore INTEGER NOT NULL,
    stressScore INTEGER NOT NULL,
    overallPercentage INTEGER NOT NULL,
    recommendation TEXT NOT NULL,
    notes TEXT NOT NULL DEFAULT '',
    createdAtEpochMs INTEGER NOT NULL
);

CREATE TABLE ai_chat_messages (
    id TEXT NOT NULL PRIMARY KEY,
    role TEXT NOT NULL,
    messageText TEXT NOT NULL,
    imagePath TEXT,
    stepLogsJson TEXT NOT NULL DEFAULT '[]',
    proposalJson TEXT,
    nutritionJson TEXT,
    isError INTEGER NOT NULL DEFAULT 0,
    createdAtEpochMs INTEGER NOT NULL
);

-- Indices for performance
CREATE INDEX idx_workout_exercises_workout ON workout_exercises(workoutId);
CREATE INDEX idx_sets_we ON sets(workoutExerciseId);
CREATE INDEX idx_sets_workout ON sets(workoutId);
CREATE INDEX idx_prs_exercise ON personal_records(exerciseId);
CREATE INDEX idx_routine_exercises_routine ON routine_exercises(routineId);
CREATE INDEX idx_workout_schedule_events_date ON workout_schedule_events(scheduledDate);
CREATE INDEX idx_mesocycles_status ON mesocycles(status);
CREATE UNIQUE INDEX idx_daily_readiness_date ON daily_readiness(dateString);

-- Queries for Workouts
selectAllCompletedWorkouts:
SELECT * FROM workouts WHERE isFinished = 1 ORDER BY startTimeEpochMs DESC;

selectWorkoutById:
SELECT * FROM workouts WHERE id = ?;

insertWorkout:
INSERT OR REPLACE INTO workouts (
    id, title, splitType, startTimeEpochMs, endTimeEpochMs,
    durationSeconds, sessionRpe, notes, isFinished,
    avgHeartRateBpm, peakHeartRateBpm, activeCaloriesKcal
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteWorkout:
DELETE FROM workouts WHERE id = ?;

-- Queries for Workout Exercises
selectWorkoutExercises:
SELECT * FROM workout_exercises WHERE workoutId = ? ORDER BY orderIndex ASC;

insertWorkoutExercise:
INSERT OR REPLACE INTO workout_exercises (
    id, workoutId, exerciseId, exerciseName, primaryMuscle, equipment, movementType, orderIndex, pinnedNote
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteWorkoutExercisesByWorkoutId:
DELETE FROM workout_exercises WHERE workoutId = ?;

-- Queries for Sets
selectSetsByWorkoutExerciseId:
SELECT * FROM sets WHERE workoutExerciseId = ? ORDER BY setNumber ASC;

selectSetsByWorkoutId:
SELECT * FROM sets WHERE workoutId = ? ORDER BY setNumber ASC;

insertSet:
INSERT OR REPLACE INTO sets (
    id, workoutExerciseId, workoutId, setNumber, setType,
    weightKg, reps, isCompleted, rpe, rir, targetWeightKg, targetReps,
    previousWeightKg, previousReps, heartRateBpm, completedAtEpochMs
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteSetsByWorkoutId:
DELETE FROM sets WHERE workoutId = ?;

deleteSetsByWorkoutExerciseId:
DELETE FROM sets WHERE workoutExerciseId = ?;

-- Queries for PRs
selectAllPrs:
SELECT * FROM personal_records ORDER BY dateAchievedEpochMs DESC;

selectPrsForExercise:
SELECT * FROM personal_records WHERE exerciseId = ? ORDER BY weightKg DESC;

insertPr:
INSERT OR REPLACE INTO personal_records (
    id, exerciseId, exerciseName, weightKg, reps, estimated1RmKg, dateAchievedEpochMs, deltaWeightKg, prTier, sourceSetId
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deletePr:
DELETE FROM personal_records WHERE id = ?;

deletePrBySourceSet:
DELETE FROM personal_records WHERE sourceSetId = ?;

deletePrsByExerciseId:
DELETE FROM personal_records WHERE exerciseId = ?;

-- Queries for Bodyweight
selectAllBodyweightLogs:
SELECT * FROM bodyweight_log ORDER BY dateEpochMs DESC;

insertBodyweightLog:
INSERT OR REPLACE INTO bodyweight_log (id, dateEpochMs, weightKg, note)
VALUES (?, ?, ?, ?);

deleteBodyweightLog:
DELETE FROM bodyweight_log WHERE id = ?;

-- Queries for Custom Exercises
selectAllCustomExercises:
SELECT * FROM custom_exercises ORDER BY createdAtEpochMs DESC;

insertCustomExercise:
INSERT OR REPLACE INTO custom_exercises (
    id, name, primaryMuscle, secondaryMuscles, equipment, movementType, defaultIncrementKg, pinnedNote, createdAtEpochMs
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteCustomExercise:
DELETE FROM custom_exercises WHERE id = ?;

-- Queries for Training Programs
selectAllTrainingPrograms:
SELECT * FROM training_programs ORDER BY isDefault DESC, createdAtEpochMs ASC;

selectTrainingProgramById:
SELECT * FROM training_programs WHERE id = ?;

insertTrainingProgram:
INSERT OR REPLACE INTO training_programs (
    id, name, description, category, targetDaysPerWeek, activeDays, isDefault, createdAtEpochMs, presetKey, isUserRenamed
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteTrainingProgram:
DELETE FROM training_programs WHERE id = ?;

clearAllTrainingPrograms:
DELETE FROM training_programs;

-- Queries for Routines
selectAllRoutines:
SELECT * FROM routines ORDER BY createdAtEpochMs DESC;

selectRoutinesByProgram:
SELECT * FROM routines WHERE programId = ? ORDER BY createdAtEpochMs DESC;

selectRoutineById:
SELECT * FROM routines WHERE id = ?;

insertRoutine:
INSERT OR REPLACE INTO routines (
    id, programId, title, splitCategory, muscleFocus, estimatedDurationMinutes, targetRpeTier, plannedSetsPerExercise, isCustom, createdAtEpochMs, scheduledDays, presetKey, isUserRenamed
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteRoutine:
DELETE FROM routines WHERE id = ?;

deleteRoutinesByProgram:
DELETE FROM routines WHERE programId = ?;

-- Queries for Routine Exercises
selectRoutineExercises:
SELECT * FROM routine_exercises WHERE routineId = ? ORDER BY orderIndex ASC;

insertRoutineExercise:
INSERT OR REPLACE INTO routine_exercises (
    id, routineId, exerciseId, orderIndex, targetSets, targetReps, targetWeightKg, restTimerSeconds, setConfigsJson
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteRoutineExercises:
DELETE FROM routine_exercises WHERE routineId = ?;

-- Queries for Active Workout State
selectActiveWorkout:
SELECT * FROM active_workout_state WHERE id = 'active' LIMIT 1;

insertActiveWorkout:
INSERT OR REPLACE INTO active_workout_state (id, workoutJson, lastUpdatedEpochMs)
VALUES ('active', ?, ?);

clearActiveWorkout:
DELETE FROM active_workout_state WHERE id = 'active';

-- Queries for User Settings Storage
selectUserSettings:
SELECT * FROM user_settings_storage WHERE id = 'current_user' LIMIT 1;

insertUserSettings:
INSERT OR REPLACE INTO user_settings_storage (id, settingsJson, version, lastUpdatedEpochMs)
VALUES ('current_user', ?, ?, ?);

-- Queries for Safety Snapshots
insertSafetySnapshot:
INSERT OR REPLACE INTO safety_snapshots (id, createdAtEpochMs, payloadJson)
VALUES (?, ?, ?);

selectLatestSafetySnapshot:
SELECT payloadJson FROM safety_snapshots ORDER BY createdAtEpochMs DESC LIMIT 1;

-- Queries for Full Data Wipe / Restore
clearAllWorkouts:
DELETE FROM workouts;

clearAllWorkoutExercises:
DELETE FROM workout_exercises;

clearAllSets:
DELETE FROM sets;

clearAllPersonalRecords:
DELETE FROM personal_records;

clearAllRoutines:
DELETE FROM routines;

clearAllRoutineExercises:
DELETE FROM routine_exercises;

clearAllCustomExercises:
DELETE FROM custom_exercises;

clearAllBodyweightLog:
DELETE FROM bodyweight_log;

-- Queries for Workout Schedule Events
selectAllScheduleEvents:
SELECT * FROM workout_schedule_events ORDER BY scheduledDate ASC, createdAtEpochMs ASC;

selectScheduleEventsByDate:
SELECT * FROM workout_schedule_events WHERE scheduledDate = ? ORDER BY createdAtEpochMs ASC;

selectScheduleEventsByDateRange:
SELECT * FROM workout_schedule_events WHERE scheduledDate >= ? AND scheduledDate <= ? ORDER BY scheduledDate ASC, createdAtEpochMs ASC;

selectScheduleEventById:
SELECT * FROM workout_schedule_events WHERE id = ?;

insertScheduleEvent:
INSERT OR REPLACE INTO workout_schedule_events (
    id, routineId, scheduledDate, status, linkedWorkoutId,
    routineTitleSnapshot, splitTypeSnapshot, notes,
    createdAtEpochMs, updatedAtEpochMs
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateScheduleEventDate:
UPDATE workout_schedule_events
SET scheduledDate = ?, updatedAtEpochMs = ?
WHERE id = ?;

updateScheduleEventStatus:
UPDATE workout_schedule_events
SET status = ?, linkedWorkoutId = ?, updatedAtEpochMs = ?
WHERE id = ?;

deleteScheduleEvent:
DELETE FROM workout_schedule_events WHERE id = ?;

clearAllWorkoutScheduleEvents:
DELETE FROM workout_schedule_events;

-- Queries for Mesocycles
selectAllMesocycles:
SELECT * FROM mesocycles ORDER BY createdAtEpochMs DESC;

selectActiveMesocycle:
SELECT * FROM mesocycles WHERE status = 'ACTIVE' LIMIT 1;

selectMesocycleById:
SELECT * FROM mesocycles WHERE id = ?;

insertOrReplaceMesocycle:
INSERT OR REPLACE INTO mesocycles (
    id, name, programId, totalWeeks, currentWeek, deloadWeek,
    isDeloadActive, startDateEpochMs, endDateEpochMs, status, notes, createdAtEpochMs
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateMesocycleWeek:
UPDATE mesocycles
SET currentWeek = ?, isDeloadActive = ?
WHERE id = ?;

updateMesocycleStatus:
UPDATE mesocycles
SET status = ?, endDateEpochMs = ?
WHERE id = ?;

deleteMesocycle:
DELETE FROM mesocycles WHERE id = ?;

clearAllMesocycles:
DELETE FROM mesocycles;

-- Queries for Daily Readiness
selectAllReadinessCheckIns:
SELECT * FROM daily_readiness ORDER BY dateString DESC;

selectReadinessByDate:
SELECT * FROM daily_readiness WHERE dateString = ? LIMIT 1;

insertOrReplaceReadiness:
INSERT OR REPLACE INTO daily_readiness(
    id, dateString, sleepScore, sorenessScore, energyScore, stressScore, overallPercentage, recommendation, notes, createdAtEpochMs
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteReadinessById:
DELETE FROM daily_readiness WHERE id = ?;

clearAllDailyReadiness:
DELETE FROM daily_readiness;

-- Queries for Kuma AI Chat Messages
selectAllAiChatMessages:
SELECT * FROM ai_chat_messages ORDER BY createdAtEpochMs ASC;

insertOrReplaceAiChatMessage:
INSERT OR REPLACE INTO ai_chat_messages (
    id, role, messageText, imagePath, stepLogsJson, proposalJson, nutritionJson, isError, createdAtEpochMs
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteAiChatMessage:
DELETE FROM ai_chat_messages WHERE id = ?;

clearAllAiChatMessages:
DELETE FROM ai_chat_messages;
